<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the plain-number logic in ../TradeWatch.cs (no cTrader needed). Run: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0162;CS0168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="1.0.21" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../TradeWatch.cs" />
    <Compile Include="Tests.cs" />
    <Compile Include="Preview.cs" />
  </ItemGroup>
</Project>
